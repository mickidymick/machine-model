# Runtime droppings from site/serve.py
site/server.pid
site/server.log

# Stale renderer traceback; regenerate by redirecting stderr if needed
render.err

__pycache__/
*.pyc

# Experiment B: benchmark source is fetched at a pinned commit by
# eval/exp-b/setup_bench.sh, never committed. Vendoring it created nested .git
# directories git cannot track and would put ~100 MB of third-party code in a
# repo whose content is the harness.
eval/exp-b/pristine-*/
eval/exp-b/pristine/
eval/exp-b/arms/*/*/src/
eval/exp-b/arms/*/*/build/
eval/exp-b/arms-r3/*/*/src/
eval/exp-b/arms-r3/*/*/build/
eval/exp-b/results/*.log
eval/exp-b/arms/*/*/SOLUTION.sh
